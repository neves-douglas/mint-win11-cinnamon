[Desktop Entry]
Type=Application
Version=1.0
Name=Instalar visual Win11
Comment=Instala tema, ícones bloom, pastas, painel e wallpaper no Linux Mint
Exec=bash -c 'cd "$(dirname "$1")" && chmod +x ./install.sh ./scripts/apply-icon-overlay.py && ./install.sh' -- %k
Terminal=true
Icon=preferences-desktop-theme
Categories=Settings;
StartupNotify=true
